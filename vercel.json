{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/badge/[^/]+/?",
      "dest": "/build/index.html"
    },
    {
      "src": "/dashboard/badging/?",
      "dest": "/build/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/build/$1"
    }
  ]
}
